<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation</title>
</head>
<body>
    <p>Order Summary</p>
    <p>Name: <%= order.fname %> <%= order.lname %></p>
    <p>Email: <%= order.email %></p>
    <p>Pickup or Delivery: <%=order.method %></p>
    <p>Toppings: <%=order.toppings %></p>
    <p>Comment: <%=order.comment%></p>
    <p>Time: <%=order.timestamp.toLocaleString() %></p>
</body>
</html>